# Copy this file to .env and fill in real values.
# .env itself must never be committed — only .env.example is.

# Supabase → Connect → Session pooler connection string.
# Use the SESSION pooler (not Direct, not Transaction) here:
# this backend is a long-lived server process, which is exactly
# what session mode is designed for.
DATABASE_URL=postgresql://postgres.***********:[Password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
PORT=****
JWT_SECRET=your key
REDIS_URL=redis://default:***********
RAZORPAY_KEY_ID=****
RAZORPAY_KEY_SECRET=*****